<?xml version='1.0' encoding='utf-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='tg-expert' Id='3062ca76-5e9f-4613-a1be-f7eed3a6ed8d' UpgradeCode='ed9a22fc-68e1-4038-b075-c41127282fe9'
    Language='1033' Codepage='1252' Version='0.12.0' Manufacturer='tg-expert'>

    <Package Id='*' Keywords='Installer'
      Description='tg-expert 0.12.0 Installer'
      Manufacturer='tg-expert'
      InstallerVersion='100' Languages='1033' Compressed='yes' SummaryCodepage='1252' />

    <MajorUpgrade AllowSameVersionUpgrades='yes' Schedule='afterInstallInitialize'
                  DowngradeErrorMessage='A newer version of [ProductName] is already installed.' />

    <Media Id='1' Cabinet='Sample.cab' EmbedCab='yes' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='INSTALLDIR' Name='tg-expert'>

          <Component Id='MainExecutable' Guid='61471117-5544-4600-8194-5cff8465524a'>
            <File Id='TgEXE' Name='tg-expert.exe' DiskId='1' Source='tg-expert.exe' KeyPath='yes'>
              <Shortcut Id='startmenuTg' Directory='ProgramMenuDir' Name='tg-expert 0.12.0' WorkingDirectory='INSTALLDIR' Icon='TgExpert.exe' IconIndex='0' Advertise='yes' />
              <Shortcut Id='desktopTg' Directory='DesktopFolder' Name='tg-expert 0.12.0' WorkingDirectory='INSTALLDIR' Icon='TgExpert.exe' IconIndex='0' Advertise='yes' />
            </File>
            <File Id='TgDocumentICO' Name='tg-document.ico' Source='tg-document.ico' />
            <ProgId Id='TgExpert.TgjFile' Description='tg-expert data file' Icon='TgDocumentICO'>
              <Extension Id='tgj' ContentType='application/x-tg-timer-data'>
                <Verb Id='open' Command='Open' TargetFile='TgEXE' Argument='"%1"' />
              </Extension>
            </ProgId>
          </Component>

          <Component Id='License' Guid='751ba548-b3cf-4785-8aad-6d0551f7e681'>
            <File Id='License' Name='LICENSE' DiskId='1' Source='LICENSE' KeyPath='yes' />
          </Component>

          <Component Id='Readme' Guid='3cb6a618-4206-4963-9c48-e6b6eae85ac7'>
            <File Id='Readme' Name='README.md' DiskId='1' Source='README.md' KeyPath='yes' />
          </Component>

          <!-- The manual goes in share\doc\tg-expert, where the program looks
               for it (GLib's system data folders), as with make install -->
          <Directory Id='ManualShareDir' Name='share'>
            <Directory Id='ManualDocDir' Name='doc'>
              <Directory Id='MANUALDIR' Name='tg-expert'>
                <Component Id='Manual' Guid='9de1a160-02e9-4830-bb73-6ef45d4b8089'>
                  <File Id='Manual' Name='tg-expert-manual.pdf' DiskId='1' Source='tg-expert-manual.pdf' KeyPath='yes' />
                </Component>
                <Component Id='ManualEs' Guid='0f7f60c9-9872-4999-8e12-83d8e3bfa7e4'>
                  <File Id='ManualEs' Name='tg-expert-manual-es.pdf' DiskId='1' Source='tg-expert-manual-es.pdf' KeyPath='yes' />
                </Component>
                <Component Id='ManualDe' Guid='bee325ad-ca30-42a2-9f87-510ca057adba'>
                  <File Id='ManualDe' Name='tg-expert-manual-de.pdf' DiskId='1' Source='tg-expert-manual-de.pdf' KeyPath='yes' />
                </Component>
              </Directory>
            </Directory>
          </Directory>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder' Name='Programs'>
        <Directory Id='ProgramMenuDir' Name='tg-expert 0.12.0'>
          <Component Id='ProgramMenuDir' Guid='221ac2aa-8a32-4d80-bd27-794e21c353d8'>
            <Shortcut Id='startmenuManual' Name='tg-expert manual' Description='tg-expert user manual (PDF)'
                      Target='[MANUALDIR]tg-expert-manual.pdf' WorkingDirectory='MANUALDIR' />
            <Shortcut Id='startmenuManualEs' Name='tg-expert manual (Español)' Description='Manual de usuario de tg-expert (PDF)'
                      Target='[MANUALDIR]tg-expert-manual-es.pdf' WorkingDirectory='MANUALDIR' />
            <Shortcut Id='startmenuManualDe' Name='tg-expert Handbuch (Deutsch)' Description='Benutzerhandbuch von tg-expert (PDF)'
                      Target='[MANUALDIR]tg-expert-manual-de.pdf' WorkingDirectory='MANUALDIR' />
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue Root='HKCU' Key='Software\[Manufacturer]\[ProductName]' Type='string' Value='' KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <Directory Id='DesktopFolder' Name='Desktop' />
    </Directory>

    <Feature Id='Complete' Level='1' ConfigurableDirectory='INSTALLDIR'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='License' />
      <ComponentRef Id='Readme' />
      <ComponentRef Id='Manual' />
      <ComponentRef Id='ManualEs' />
      <ComponentRef Id='ManualDe' />
      <ComponentGroupRef Id='Resources' />
      <ComponentRef Id='ProgramMenuDir' />
    </Feature>

    <Property Id='WIXUI_INSTALLDIR' Value='INSTALLDIR' />

    <WixVariable Id='WixUILicenseRtf' Value='LICENSE.rtf' />

    <!-- Last dialog: a "Launch tg-expert" checkbox, ticked by default -->
    <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Launch tg-expert' />
    <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1' />
    <Property Id='WixShellExecTarget' Value='[#TgEXE]' />
    <CustomAction Id='LaunchApplication' BinaryKey='WixCA' DllEntry='WixShellExec' Impersonate='yes' />

    <UI>
      <UIRef Id='WixUI_InstallDir' />
      <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchApplication'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
    <UIRef Id='WixUI_ErrorProgressText' />

    <Icon Id='TgExpert.exe' SourceFile='tg-expert.exe' />

  </Product>
</Wix>
